# ==============================================================================
# WeatherPulse India - Environment Configuration (.env.example)
# Guidelines for Indian Government Websites (GIGW) Compliant Weather Intelligence
# ==============================================================================

# Core Application Runtime (Zero Mock Data Policy)
USE_MOCK_DATA=false
NODE_ENV=production
SPRING_PROFILES_ACTIVE=prod
ENABLE_SWAGGER=false
PORT=8080

# 1. Database & Persistence (PostgreSQL with PostGIS)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=weatherpulse
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
DATABASE_URL=postgresql://postgres:your_local_postgres_password@localhost:5433/weatherpulse

# 2. Authentication & RBAC Secrets
JWT_SECRET=weatherpulse_gov_jwt_secure_secret_key_2026_kolkata
ADMIN_EMAIL=admin@weatherpulse.in
ADMIN_PASSWORD=Admin@WeatherPulse2026

# 3. Government & Open Data Meteorological APIs
# Open-Meteo High Resolution NWP is keyless and batched by default
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
IMD_CDSP_TOKEN=your_imd_cdsp_api_token_here
NDMA_SACHET_FEED_URL=https://sachet.ndma.gov.in/cap/rss

# 4. Satellite, Earth Observation & Disaster Feeds
GDACS_FEED_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH?eventlist=TC,FL,EQ,VO,DR
USGS_EARTHQUAKE_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_week.geojson
NASA_POWER_CLIMATOLOGY_URL=https://power.larc.nasa.gov/api/temporal/climatology/point
OPENWEATHER_API_KEY=your_openweather_api_key_here
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key_here

# 5. Global Weather API Key Settings
DEFAULT_DEV_API_KEY=wp_live_global_key_2026_gov
API_DEFAULT_RATE_LIMIT=120

# 6. SMS & Email Alert Providers (Multi-Provider Dispatch)
# SMS_PROVIDER: twilio | fast2sms | msg91 | dryrun
# EMAIL_PROVIDER: smtp | sendgrid | dryrun
SMS_PROVIDER=dryrun
EMAIL_PROVIDER=dryrun
SMS_DRY_RUN=true
EMAIL_DRY_RUN=true

# Email Providers (SMTP / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=alerts@weatherpulse.in

# SMS Providers (India DLT: MSG91 / Fast2SMS | International: Twilio)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=WTHPLS
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# 7. Distributed Caching & Event Bus
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379
