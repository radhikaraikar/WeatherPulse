# ==============================================================================
# WeatherPulse India - Production Cloud Environment Template (.env.production)
# WARNING: Inject via GitHub Actions Secrets / Cloud Secrets Manager.
# ==============================================================================

# Core Production Mode
USE_MOCK_DATA=false
NODE_ENV=production

# Managed PostgreSQL + PostGIS (AWS RDS / GCP Cloud SQL / Supabase)
POSTGRES_DB=weatherpulse_prod
POSTGRES_USER=weatherpulse_admin
POSTGRES_PASSWORD=${PROD_DB_SECRET_PASSWORD}
POSTGRES_PORT=5432
DATABASE_URL=postgresql://weatherpulse_admin:${PROD_DB_SECRET_PASSWORD}@prod-db.weatherpulse.internal:5432/weatherpulse_prod

# Managed Redis (AWS ElastiCache / GCP Memorystore / Upstash)
REDIS_PORT=6379
REDIS_URL=rediss://default:${PROD_REDIS_SECRET_TOKEN}@prod-redis.weatherpulse.internal:6379

# Managed Apache Kafka / Redpanda (AWS MSK / Confluent Cloud / Redpanda)
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxx.ap-south-1.aws.confluent.cloud:9092
KAFKA_SASL_USERNAME=${PROD_KAFKA_KEY}
KAFKA_SASL_PASSWORD=${PROD_KAFKA_SECRET}
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN

# Live Indian Government & Weather APIs
DATA_GOV_IN_API_KEY=${PROD_DATA_GOV_IN_API_KEY}
OPENWEATHER_API_KEY=${PROD_OPENWEATHER_API_KEY}
GOOGLE_GEOCODING_API_KEY=${PROD_GOOGLE_GEOCODING_KEY}
X_API_BEARER_TOKEN=${PROD_X_API_BEARER_TOKEN}

# Cloud Object Storage for Media Uploads (AWS S3 / GCP GCS / Cloudflare R2)
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=weatherpulse-citizen-uploads
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=${AWS_S3_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${AWS_S3_SECRET_KEY}

# JWT Authentication Secrets
JWT_SECRET_KEY=${PROD_JWT_SECRET_SIGNING_KEY}
JWT_EXPIRATION_HOURS=24
