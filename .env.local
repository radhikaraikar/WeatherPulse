# ==============================================================================
# WeatherPulse India - Local Development Configuration (.env.local)
# ==============================================================================

# Core Application Mode
USE_MOCK_DATA=true
NODE_ENV=development

# Database & Broker (Local Docker addresses)
POSTGRES_DB=weatherpulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/weatherpulse_db

REDIS_PORT=6379
REDIS_URL=redis://redis:6379

KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Public Meteorological APIs (Mock & Keyless Free Tiers for Local Dev)
OPENWEATHER_API_KEY=mock_dev_key
DATA_GOV_IN_API_KEY=mock_data_gov_in_key
GOOGLE_GEOCODING_API_KEY=mock_google_key
X_API_BEARER_TOKEN=mock_x_token

# Storage (Local Mock / Docker Volume)
STORAGE_PROVIDER=local
UPLOAD_DIR=/tmp/weatherpulse_uploads
